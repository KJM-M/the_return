  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Item
  itemName: tapestry
  description: a threadbare <color=#8FA6C9><b>tapestry</b></color> hanging from the wall, its faded green and silver threads hinting at a land swallowed by the mist.
  locationSprite: {fileID: 0}
  locationSpritePosition: {x: 0, y: 0}
  locationSpriteSize: {x: 100, y: 100}
  locationSpriteRotation: 0
  playerCanTake: 0
  itemEnabled: 1
  targgetItem: {fileID: 0}
  interactions:
  - action: {fileID: 11400000, guid: 658405d1e7ff410749efa0f6d153ab58, type: 2}
    response: 'You brush away the dust and cobwebs. A map emerges from the moth-eaten fabric: a green land surrounded by a silver sea. Most of its markings have faded, but one name remains legible along the torn border: <color=#8FA6C9><b>Albion</b></color>. The fabric around the name is worn thin, as though someone has traced the letters many times.'
    interactionImage: {fileID: 21300000, guid: d94ce84b88b857e92a725373b1baae01, type: 3}
    interactionImageDuration: 4
    locationImageAfterInteraction: {fileID: 0}
