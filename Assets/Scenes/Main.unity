  historyScrollRect: {fileID: 1261884608}
  currentText: {fileID: 205193863}
  currentScrollRect: {fileID: 1701535442}
  titleText: {fileID: 17556150}
  actions:
  - {fileID: 11400000, guid: ab2e47650836b85e0bb05002e3914fbe, type: 2}
  - {fileID: 11400000, guid: 9c73bf52e9caaadae8cc8d9f67a49d27, type: 2}
  - {fileID: 11400000, guid: 658405d1e7ff410749efa0f6d153ab58, type: 2}
  - {fileID: 11400000, guid: 25acdda59d9bcd170b4b67f788ed0109, type: 2}
  - {fileID: 11400000, guid: ca1fcb8e13c145e178758f7a00741de2, type: 2}
  - {fileID: 11400000, guid: 4d39c6d66ac686b9cbe53736631a154a, type: 2}
  - {fileID: 11400000, guid: cd9d033919522022dbbc95f582e4d4f8, type: 2}
  - {fileID: 11400000, guid: c07d6be353345ba60b446af84877ed9e, type: 2}
  - {fileID: 11400000, guid: 7d0d3b499d98886a2963ac29e5de3fd1, type: 2}
  - {fileID: 11400000, guid: 8f07612ec51c5de1590ac7eb38878813, type: 2}
  combinations:
  - firstItem: {fileID: 1598477252}
    secondItem: {fileID: 272839926}
    resultItem: {fileID: 1073510381}
    response: You strike a match and light the lantern. A warm flame settles behind the glass.
    interactionImage: {fileID: 21300000, guid: 2c04473b371bcd57681c96311d1b2361, type: 3}
    interactionImageDuration: 4
    connectionsToDisable: []
    connectionsToEnable:
    - {fileID: 694109436}
  - firstItem: {fileID: 879494643}
    secondItem: {fileID: 239832559}
    resultItem: {fileID: 1871562831}
    response: "You press the serpent\u2019s fang against the end of the staff. The wood twists around it with a splintering groan, holding it fast. A pulse of warmth travels through the staff, and its weight settles naturally into your hands."
    interactionImage: {fileID: 21300000, guid: 70e6d39ca33cf3e53aca7ffc0a552108, type: 3}
    interactionImageDuration: 4
    connectionsToDisable: []
    connectionsToEnable:
    - {fileID: 694109436}
  locationArt: {fileID: 2029108964}
  helpAction: {fileID: 11400000, guid: 7c0c57cde4176f9bea7561a4b592bcb7, type: 2}
  introText: 'The crack of splintering wood. Fire. A scream. Black water closing overhead. Then nothing.


    You wake face down in damp moss, drawing a ragged breath that tastes of earth and smoke. Roots cling to your arms, and black sap stains your skin. Your body aches as though it has been broken and carelessly made whole again. Something has brought you back, though you cannot remember what.


    You force yourself upright and pull a fallen branch from the roots. The wood is old and weathered, but strangely warm in your grasp. Around you lies an island of black rock. The sea surrounding it is perfectly still. Beyond the shore, the world ends in white fog.'
--- !u!114 &2029108964
