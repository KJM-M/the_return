  interactions:
  - action: {fileID: 11400000, guid: ca1fcb8e13c145e178758f7a00741de2, type: 2}
    response: The crone stares into the fire, her shoulders tense with anger. When you speak, she lets out a low, furious growl but does not turn to look at you or acknowledge you further.
    interactionImage: {fileID: 0}
    interactionImageDuration: 0
    locationImageAfterInteraction: {fileID: 0}
