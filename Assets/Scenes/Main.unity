  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Location
  locationName: East Antechamber
  locationImage: {fileID: 21300000, guid: e9fdcfb9fa49a8a718a5ef272b6689f4, type: 3}
  description: "You stand in a cramped antechamber. Broken stone crunches beneath your feet, and the missing pieces of the chapel\u2019s statue lie scattered across the floor. The destruction looks too deliberate to be the work of time alone.<br>"
  connections:
  - {fileID: 1567127236}
  items:
  - {fileID: 435806410}
--- !u!1 &1900187538
GameObject:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
