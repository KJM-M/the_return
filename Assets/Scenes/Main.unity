  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Item
  itemName: ferryman
  description: a robed <color=#8FA6C9><b>ferryman</b></color> waiting in the narrow boat, his hooded face turned toward you in silent expectation.
  locationSprite: {fileID: 0}
  locationSpritePosition: {x: 0, y: 0}
  locationSpriteSize: {x: 100, y: 100}
  locationSpriteRotation: 0
  playerCanTake: 0
  itemEnabled: 1
  targgetItem: {fileID: 0}
  interactions:
  - action: {fileID: 11400000, guid: ca1fcb8e13c145e178758f7a00741de2, type: 2}
    response: "The Ferryman turns his hooded face toward you. For a moment, he says nothing. \u201CA living soul,\u201D he murmurs at last. \u201CIt has been a long time since one came to this shore.\u201D He extends an open hand. \u201CIf you seek passage, you must pay the price.\u201D"
    interactionImage: {fileID: 0}
    interactionImageDuration: 2
    locationImageAfterInteraction: {fileID: 0}
