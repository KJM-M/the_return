  - action: {fileID: 11400000, guid: ca1fcb8e13c145e178758f7a00741de2, type: 2}
    response: "The crone holds out a weathered hand. \u201CMy amulet. Return it, and I will open your way off this island. I have no more patience for questions\u2014or for Merlin\u2019s shadow in my home.\u201D"
    interactionImage: {fileID: 0}
