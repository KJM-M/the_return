  m_Script: {fileID: 11500000, guid: 0173eef0fea17567bba13b827ae8eeaa, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Item
  itemName: staff
  description: a weathered wooden <color=#8FA6C9><b>staff</b></color>, faintly warm to the touch.
  locationSprite: {fileID: 0}
  locationSpritePosition: {x: 0, y: 0}
  locationSpriteSize: {x: 100, y: 100}
  locationSpriteRotation: 0
  playerCanTake: 1
  itemEnabled: 1
  targgetItem: {fileID: 1723894001}
  interactions:
  - action: {fileID: 11400000, guid: 25acdda59d9bcd170b4b67f788ed0109, type: 2}
    response: "You lunge forward, and the staff flares with blinding light. A single sweeping blow severs the serpent\u2019s head. Its coils crash to the floor as coins burst from the open neck, scattering across the stones. Still they pour out, gold and silver streaming from the body where blood should be."
