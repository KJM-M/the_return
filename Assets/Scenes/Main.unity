  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Item
  itemName: head
  description: "a stone <color=#8FA6C9><b>head</b></color> lying among the statue\u2019s remains, its worn features turned toward the doorway as though watching it."
  locationSprite: {fileID: 0}
  locationSpritePosition: {x: 0, y: 0}
  locationSpriteSize: {x: 100, y: 100}
  locationSpriteRotation: 0
  playerCanTake: 0
  itemEnabled: 1
  targgetItem: {fileID: 0}
  interactions:
  - action: {fileID: 11400000, guid: 658405d1e7ff410749efa0f6d153ab58, type: 2}
    response: 'You lift the stone head and turn its face toward you. It clearly came from the broken statue in the chapel. The worn features seem familiar, and a name comes to you: <color=#8FA6C9><b>Merlin</b></color>. You speak it aloud. Around the neck, the stone is scarred by repeated blows. Whoever broke the statue did not do so by accident.'
    interactionImage: {fileID: 21300000, guid: 1bf5f4bb50b21bc49a44753a8a39120e, type: 3}
    interactionImageDuration: 4
    locationImageAfterInteraction: {fileID: 0}
