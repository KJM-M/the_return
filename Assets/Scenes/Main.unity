--- !u!114 &1900187539
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1900187538}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0173eef0fea17567bba13b827ae8eeaa, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Item
  itemName: crone
  description: an old <color=#8FA6C9><b>crone</b></color> sitting beside the fire, her hood drawn low over her face.
  locationSprite: {fileID: 0}
  locationSpritePosition: {x: 0, y: 0}
  locationSpriteSize: {x: 100, y: 100}
  locationSpriteRotation: 0
  playerCanTake: 0
  itemEnabled: 1
  targgetItem: {fileID: 0}
  interactions:
  - action: {fileID: 11400000, guid: ca1fcb8e13c145e178758f7a00741de2, type: 2}
    response: "The crone raises her head slowly. Her gaze fixes on the amulet you carry. \u201CSo. The serpent is dead, and my own amulet has carried you through my barrier.\u201D A thin smile appears beneath the hood. \u201CHow resourceful. Tell me, stranger\u2014whose ghost are you chasing?\u201D"
    interactionImage: {fileID: 0}
    interactionImageDuration: 0
    locationImageAfterInteraction: {fileID: 0}
    textToMatch: 
    itemsToDisable: []
    itemsToEnable: []
    temporaryItemsToEnable: []
    temporaryItemsToDisable: []
    connectionsToDisable: []
    connectionsToEnable: []
    connectionsToUnlock: []
    itemsToAddToInventory: []
    teleportLocation: {fileID: 0}
  - action: {fileID: 11400000, guid: 4d39c6d66ac686b9cbe53736631a154a, type: 2}
    response: "\u201CMerlin.\u201D The name sounds less like a word than an old wound. \u201COf course. It is always Merlin. Merlin the wise, Merlin the blessed, Merlin whose light the rest of us were meant to admire.\u201D The crone gives a quiet, mirthless laugh. \u201CI know how brightly he burned\u2014and what he left in shadow.\u201D She leans toward you. \u201CBut let us see what you truly know. What was the name of the land he called his own?\u201D"
    interactionImage: {fileID: 0}
    interactionImageDuration: 0
    locationImageAfterInteraction: {fileID: 0}
    textToMatch: merlin
    itemsToDisable:
    - {fileID: 1900187539}
    itemsToEnable:
    - {fileID: 90360020}
    temporaryItemsToEnable: []
    temporaryItemsToDisable: []
    connectionsToDisable: []
    connectionsToEnable: []
    connectionsToUnlock: []
    itemsToAddToInventory: []
    teleportLocation: {fileID: 0}
  - action: {fileID: 11400000, guid: 658405d1e7ff410749efa0f6d153ab58, type: 2}
    response: The old woman sits perfectly still, her face little more than a shadow beneath the hood. Her hands are thin and knotted with age, but there is nothing frail in the way she watches you. The firelight seems to bend around her.
    interactionImage: {fileID: 0}
    interactionImageDuration: 0
    locationImageAfterInteraction: {fileID: 0}
    textToMatch: 
    itemsToDisable: []
    itemsToEnable: []
    temporaryItemsToEnable: []
    temporaryItemsToDisable: []
    connectionsToDisable: []
    connectionsToEnable: []
    connectionsToUnlock: []
    itemsToAddToInventory: []
    teleportLocation: {fileID: 0}
  itemsToDrop: []
  playerCanTalkTo: 1
  playerCanGiveTo: 0
  playerCanRead: 0
