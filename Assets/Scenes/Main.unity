--- !u!114 &90360020
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 90360019}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0173eef0fea17567bba13b827ae8eeaa, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Item
  itemName: crone
  description: an old <color=#8FA6C9><b>crone</b></color> sitting beside the fire, her hood drawn low over her face.
  locationSprite: {fileID: 0}
  locationSpritePosition: {x: 0, y: 0}
  locationSpriteSize: {x: 100, y: 100}
  locationSpriteRotation: 0
  playerCanTake: 0
  itemEnabled: 0
  targgetItem: {fileID: 0}
  interactions:
  - action: {fileID: 11400000, guid: ca1fcb8e13c145e178758f7a00741de2, type: 2}
    response: "The crone studies you for a long moment. \u201CYou know his name. But do you know the land that shaped him?\u201D Her gaze drifts toward the chapel wall. \u201CTell me\u2014what was this land called before the mist took it?\u201D"
    interactionImage: {fileID: 0}
    interactionImageDuration: 0
    locationImageAfterInteraction: {fileID: 0}
    textToMatch: 
    itemsToDisable: []
    itemsToEnable: []
    temporaryItemsToEnable: []
    temporaryItemsToDisable: []
    connectionsToDisable: []
    connectionsToEnable: []
    connectionsToUnlock: []
    itemsToAddToInventory: []
    teleportLocation: {fileID: 0}
  - action: {fileID: 11400000, guid: 4d39c6d66ac686b9cbe53736631a154a, type: 2}
    response: "\u201CAlbion.\u201D For a moment, the crone says nothing. \u201CYes. He spoke of it as though its rivers answered to him, as though its kings were merely pieces on his board.\u201D Her voice hardens. \u201CYou see? Even now, I remember too much.\u201D She holds out a weathered hand. \u201CReturn my amulet. You have used it to come this far, and I will not have it carried away in his name. Give it to me, and I will open your way off this island. Then go, and do not return. I have heard enough of Merlin to last me another lifetime.\u201D"
    interactionImage: {fileID: 0}
    interactionImageDuration: 0
    locationImageAfterInteraction: {fileID: 0}
    textToMatch: albion
    itemsToDisable:
    - {fileID: 90360020}
    itemsToEnable:
    - {fileID: 1963999325}
    temporaryItemsToEnable: []
    temporaryItemsToDisable: []
    connectionsToDisable: []
    connectionsToEnable: []
    connectionsToUnlock: []
    itemsToAddToInventory: []
    teleportLocation: {fileID: 0}
  - action: {fileID: 11400000, guid: 658405d1e7ff410749efa0f6d153ab58, type: 2}
    response: The old woman sits perfectly still, her face little more than a shadow beneath the hood. Her hands are thin and knotted with age, but there is nothing frail in the way she watches you. The firelight seems to bend around her.
    interactionImage: {fileID: 0}
    interactionImageDuration: 0
    locationImageAfterInteraction: {fileID: 0}
    textToMatch: 
    itemsToDisable: []
    itemsToEnable: []
    temporaryItemsToEnable: []
    temporaryItemsToDisable: []
